      link_text: (link.textContent || link.getAttribute("aria-label") || "")
        .trim()
        .replace(/\s+/g, " "),
      transport_type: "beacon",
    };

    if (link.dataset.gaPlacement) {
      eventData.cta_placement = link.dataset.gaPlacement;
    }
    if (link.dataset.gaCase) {
