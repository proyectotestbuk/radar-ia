:root{--pc-paper:#f2eee4;--pc-ink:#10232b;--pc-red:#e13e2a;--pc-red-dark:#bf2c1c;--pc-lime:#cde864;--pc-line:rgba(16,35,43,.28);--pc-display:"Arial Narrow","Roboto Condensed",Arial,sans-serif;--pc-serif:Cardo,Georgia,"Times New Roman",serif;--pc-sans:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.wp-site-blocks:has(.pc-home){padding-left:0!important;padding-right:0!important}.wp-block-post-content:has(>.pc-home){margin:0!important;max-width:none!important;padding:0!important}.wp-site-blocks>.wp-block-template-part:has(.pc-site-header),.wp-site-blocks>.wp-block-template-part:has(.pc-site-footer),.wp-site-blocks>.wp-block-post-content:has(>.pc-home){margin-block-start:0!important}.pc-site-header,.pc-site-footer,.pc-home,.pc-home *,.pc-site-header *,.pc-site-footer *{box-sizing:border-box}.pc-site-header,.pc-site-footer,.pc-home{font-family:var(--pc-sans);min-width:0}.pc-site-header a,.pc-site-footer a,.pc-home a{color:inherit;text-decoration:none}.pc-site-header a:focus-visible,.pc-site-footer a:focus-visible,.pc-home a:focus-visible{outline:3px solid var(--pc-lime);outline-offset:5px}.pc-site-header{align-items:center;backdrop-filter:blur(18px);background:color-mix(in srgb,var(--pc-paper) 90%,transparent);border-bottom:1px solid var(--pc-line);color:var(--pc-ink);display:grid;grid-template-columns:1fr auto 1fr;min-height:78px;padding:0 3vw;position:sticky;top:0;width:100vw;margin-left:calc(50% - 50vw);z-index:999}.pc-signature{font-family:var(--pc-serif);font-size:clamp(1.35rem,2.4vw,2rem);font-style:italic;font-weight:700;letter-spacing:-.06em;white-space:nowrap;width:fit-content}.pc-signature span{color:var(--pc-red)}.pc-nav{display:flex;gap:2.5rem;font-size:.8rem;font-weight:750;letter-spacing:.06em;text-transform:uppercase}.pc-nav a,.pc-site-footer a,.pc-text-link{border-bottom:1px solid transparent;transition:border-color .18s ease}.pc-nav a:hover,.pc-site-footer a:hover,.pc-text-link:hover{border-color:currentColor}.pc-header-cta{align-items:center;background:var(--pc-ink);color:var(--pc-paper)!important;display:inline-flex;font-size:.78rem;font-weight:800;gap:.35em;justify-self:end;letter-spacing:.02em;padding:.9rem 1.1rem}.pc-header-cta span,.pc-primary-button span,.pc-case a span,.pc-episode a span{display:inline-block;transition:transform .18s ease}.pc-header-cta:hover span,.pc-primary-button:hover span,.pc-case a:hover span,.pc-episode a:hover span{transform:translate(3px,-3px)}.pc-home{background:var(--pc-paper);color:var(--pc-ink);margin-left:calc(50% - 50vw);max-width:none!important;overflow-x:clip;width:100vw}.pc-home img{display:block;height:auto;max-width:100%}.pc-hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(360px,.92fr);min-height:calc(100svh - 78px);overflow:hidden;position:relative}.pc-hero-kicker{color:color-mix(in srgb,var(--pc-red) 8%,transparent);font-family:var(--pc-display);font-size:clamp(7rem,17vw,17rem);font-weight:950;inset:-4vw auto auto -.7vw;letter-spacing:-.1em;line-height:.62;position:absolute;text-transform:uppercase;user-select:none;white-space:nowrap;writing-mode:vertical-rl}.pc-hero-kicker span{display:block}.pc-hero-copy{align-self:center;max-width:900px;padding:8vw 4vw 9vw 8vw;position:relative;z-index:2}.pc-eyebrow,.pc-section-index{font-size:.72rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.pc-hero h1{font-family:var(--pc-display);font-size:clamp(3.7rem,7.7vw,8.2rem);font-weight:900;letter-spacing:-.075em;line-height:.86;margin:2rem 0;max-width:12ch;text-transform:uppercase}.pc-hero h1 em{color:var(--pc-red);display:block;font-family:var(--pc-serif);font-size:.86em;font-weight:400;letter-spacing:-.065em;line-height:.9;text-transform:none}.pc-hero-intro{font-family:var(--pc-serif);font-size:clamp(1.18rem,1.9vw,1.65rem);line-height:1.35;max-width:34rem}.pc-hero-actions{align-items:center;display:flex;flex-wrap:wrap;gap:1.6rem;margin-top:2.8rem}.pc-primary-button{background:var(--pc-red);color:#fff!important;display:inline-flex;font-size:.88rem;font-weight:850;gap:2rem;justify-content:space-between;letter-spacing:.02em;padding:1.1rem 1.3rem}.pc-text-link{font-size:.86rem;font-weight:800}.pc-hero-portrait{background:var(--pc-ink);height:calc(100svh - 78px);margin:0;min-height:680px;overflow:hidden;position:relative}.pc-hero-portrait:after{background:linear-gradient(180deg,transparent 55%,rgba(6,20,26,.88));content:"";inset:0;pointer-events:none;position:absolute}.pc-hero-portrait img{filter:saturate(.78) contrast(1.07);height:100%;object-fit:cover;object-position:60% center;transition:filter .4s ease,transform .8s ease;width:100%}.pc-hero-portrait:hover img{filter:saturate(1) contrast(1.03);transform:scale(1.015)}.pc-hero-portrait figcaption{bottom:2rem;color:#fff;font-size:.68rem;font-weight:800;left:2rem;letter-spacing:.13em;position:absolute;text-transform:uppercase;z-index:2}.pc-hero-portrait figcaption span{color:var(--pc-lime);display:block;font-family:var(--pc-serif);font-size:1.15rem;font-style:italic;font-weight:400;letter-spacing:normal;margin-top:.35rem;text-transform:none}.pc-margin-note{background:var(--pc-lime);bottom:1.5rem;font-family:var(--pc-serif);font-size:.95rem;font-style:italic;line-height:1.4;margin:0;max-width:24rem;padding:1.3rem 1.5rem;position:absolute;right:calc(50% - 2rem);transform:rotate(-2deg);z-index:5}.pc-manifesto{border-top:1px solid var(--pc-line);display:grid;gap:5vw;grid-template-columns:.55fr 1fr 1.35fr;padding:9vw 5vw}.pc-manifesto-copy{font-family:var(--pc-serif);font-size:clamp(1.1rem,1.8vw,1.5rem);line-height:1.45}.pc-manifesto-copy .pc-lead{font-size:clamp(1.8rem,3vw,3.3rem);letter-spacing:-.04em;line-height:1.05;margin-top:0}.pc-method{border-top:1px solid var(--pc-ink);list-style:none;margin:0;padding:0}.pc-method li{border-bottom:1px solid var(--pc-line);display:grid;gap:.5rem 1rem;grid-template-columns:2.2rem 1fr;padding:1.25rem 0}.pc-method strong{font-size:1.05rem}.pc-method p{grid-column:2;line-height:1.45;margin:0}.pc-step-number{color:var(--pc-red);font-family:var(--pc-serif);font-style:italic}.pc-cases{background:var(--pc-ink);color:var(--pc-paper);display:grid;gap:1px;grid-template-columns:.45fr .95fr 1fr 1fr;padding:7vw 3vw}.pc-section-index.pc-light{color:var(--pc-lime)}.pc-cases-heading{padding-right:3vw}.pc-cases-heading h2,.pc-episode h2,.pc-final-cta h2{font-family:var(--pc-display);font-size:clamp(2.8rem,5vw,5.8rem);font-weight:900;letter-spacing:-.07em;line-height:.92;margin:0;text-transform:uppercase}.pc-cases-heading h2{color:var(--pc-paper)}.pc-cases-heading p{color:color-mix(in srgb,var(--pc-paper) 68%,transparent);line-height:1.5;margin-top:2rem;max-width:30rem}.pc-case{border-left:1px solid rgba(242,238,228,.22);display:flex;flex-direction:column;min-height:540px;padding:0 2.2vw}.pc-case-meta{display:flex;flex-wrap:wrap;font-size:.68rem;font-weight:800;gap:.7rem;justify-content:space-between;letter-spacing:.08em;text-transform:uppercase}.pc-case-meta a{text-decoration-color:var(--pc-lime);text-decoration-thickness:1px;text-underline-offset:.25em}.pc-approved-label{color:var(--pc-lime)}.pc-case-visual{aspect-ratio:16/9;border-bottom:3px solid var(--pc-lime);display:block;margin-top:2rem;overflow:hidden;position:relative}.pc-case-visual:after{background:var(--pc-red);content:"";inset:0;mix-blend-mode:color;opacity:.48;pointer-events:none;position:absolute}.pc-case-visual img{filter:grayscale(1) contrast(1.18) brightness(.82);height:100%;object-fit:cover;transition:filter .28s ease,transform .5s ease;width:100%}.pc-case-esteban .pc-case-visual img{object-position:50% 72%}.pc-case-ernesto .pc-case-visual img{object-position:50% 12%}.pc-case-visual:hover img{filter:grayscale(.7) contrast(1.12) brightness(.9);transform:scale(1.025)}.pc-case-play{align-items:center;background:var(--pc-lime);border-radius:50%;display:flex;font-size:0;height:3.5rem;justify-content:center;left:50%;position:absolute;top:50%;transform:translate(-50%,-50%);transition:transform .18s ease;width:3.5rem;z-index:2}.pc-case-play:before{border-bottom:.48rem solid transparent;border-left:.78rem solid var(--pc-ink);border-top:.48rem solid transparent;content:"";display:block;left:50%;position:absolute;top:50%;transform:translate(-42%,-50%)}.pc-case-visual:hover .pc-case-play{transform:translate(-50%,-50%) scale(1.06)}.pc-case-figure{color:var(--pc-lime);font-family:var(--pc-display);font-size:clamp(3.2rem,5.7vw,6.5rem);font-weight:950;letter-spacing:-.08em;line-height:.9;margin:2.2rem 0 1.5rem;white-space:nowrap}.pc-case-figure span{color:var(--pc-red);font-family:var(--pc-serif);font-size:.7em;font-style:italic}.pc-case h3{color:var(--pc-paper);font-family:var(--pc-serif);font-size:clamp(1.45rem,2.1vw,2.2rem);letter-spacing:-.035em;line-height:1.1;margin:0 0 1rem}.pc-case>p:not(.pc-case-figure){color:color-mix(in srgb,var(--pc-paper) 75%,transparent);font-size:.9rem;line-height:1.55}.pc-case-story-link{color:var(--pc-lime)!important;font-size:.82rem;font-weight:800;margin-top:1rem;width:fit-content}.pc-case small{color:color-mix(in srgb,var(--pc-paper) 50%,transparent);font-size:.68rem;margin-top:auto;padding-top:2rem}.pc-podcast{padding:9vw 5vw}.pc-podcast-stats{border-bottom:1px solid var(--pc-ink);display:grid;grid-template-columns:repeat(3,1fr);margin:5vw 0 7vw 25%}.pc-podcast-stats div{border-left:1px solid var(--pc-line);display:flex;flex-direction:column;padding:1rem 2vw 2rem}.pc-podcast-stats strong{font-family:var(--pc-display);font-size:clamp(3.5rem,7vw,8rem);font-weight:950;letter-spacing:-.08em;line-height:.9}.pc-podcast-stats span{font-size:.75rem;font-weight:800;margin-top:.7rem;text-transform:uppercase}.pc-episode{align-items:center;background:var(--pc-red);color:#fff;display:grid;gap:3vw;grid-template-columns:.35fr 1.6fr .35fr;padding:4vw}.pc-episode-mark{align-items:center;background:var(--pc-lime);border-radius:50%;color:var(--pc-ink)!important;display:flex;font-size:0;height:7rem;justify-content:center;position:relative;transform:rotate(-7deg);transition:transform .18s ease;width:7rem}.pc-episode-mark:before{border-bottom:.8rem solid transparent;border-left:1.3rem solid var(--pc-ink);border-top:.8rem solid transparent;content:"";display:block;left:50%;position:absolute;top:50%;transform:translate(-42%,-50%)}.pc-episode a.pc-episode-mark span{display:none}.pc-episode-mark:hover{transform:rotate(-2deg) scale(1.04)}.pc-episode h2{font-size:clamp(2.8rem,5vw,5.5rem);max-width:16ch}.pc-episode p:not(.pc-eyebrow){line-height:1.5;max-width:40rem}.pc-episode>a{align-self:end;border-bottom:2px solid #fff;font-weight:850;justify-self:end;padding-bottom:.4rem}.pc-source-note{display:flex;font-size:.72rem;justify-content:space-between;letter-spacing:.04em;padding:1rem 0}.pc-source-note a{font-weight:800}.pc-about{background:var(--pc-red);color:#fff;display:grid;gap:5vw;grid-template-columns:.4fr 1.2fr .8fr;padding:8vw 5vw}.pc-about-quote{font-family:var(--pc-serif);font-size:clamp(2rem,4vw,4.5rem);letter-spacing:-.05em;line-height:1.03;margin:0}.pc-about-body{font-size:1rem;line-height:1.6}.pc-about-body p{margin-top:0}.pc-final-cta{padding:10vw 5vw;text-align:center}.pc-final-cta h2{font-size:clamp(4rem,9vw,10rem);margin:1rem auto 3rem;max-width:13ch}.pc-primary-button.pc-inverse{background:var(--pc-ink);min-width:min(340px,90vw)}.pc-site-footer{align-items:start;background:var(--pc-ink);color:var(--pc-paper);display:grid;gap:2rem;grid-template-columns:1fr 1fr 1fr auto;margin-left:calc(50% - 50vw);padding:4vw 5vw;width:100vw}.pc-site-footer p,.pc-site-footer small{color:color-mix(in srgb,var(--pc-paper) 62%,transparent);font-size:.8rem;margin:0}.pc-footer-links{display:flex;flex-wrap:wrap;font-size:.8rem;font-weight:750;gap:1.5rem}@media(max-width:1100px){.pc-site-header{grid-template-columns:1fr auto}.pc-nav{display:none}.pc-hero{grid-template-columns:1fr .9fr}.pc-hero-copy{padding-left:5vw}.pc-margin-note{max-width:20rem;right:calc(45% - 2rem)}.pc-manifesto{grid-template-columns:.4fr 1fr 1.2fr}.pc-cases{grid-template-columns:.25fr .75fr 1fr}.pc-cases-heading{grid-column:2/4}.pc-case-esteban{grid-column:2/3;margin-top:4rem}.pc-case-ernesto{grid-column:3/4;margin-top:4rem}}@media(max-width:760px){html{scroll-padding-top:68px}.pc-site-header{gap:.75rem;grid-template-columns:minmax(0,1fr) auto;min-height:68px;padding:0 1rem}.pc-header-cta{font-size:.68rem;max-width:11rem;padding:.75rem;white-space:nowrap}.pc-hero{display:flex;flex-direction:column}.pc-hero-copy{padding:5rem 1.2rem 3rem}.pc-hero h1{font-size:clamp(3.1rem,13.4vw,5rem);overflow-wrap:normal}.pc-hero-kicker{display:none}.pc-hero-portrait{height:72svh;min-height:520px;order:2}.pc-hero-portrait img{object-position:56% center}.pc-margin-note{bottom:auto;max-width:calc(100% - 2.4rem);order:3;position:relative;right:auto;transform:translateY(-1.5rem) rotate(-1deg);z-index:4}.pc-manifesto,.pc-cases,.pc-about{display:block;padding:5rem 1.2rem}.pc-manifesto-copy{margin:3rem 0}.pc-cases-heading{margin:3rem 0 4rem}.pc-case{border-left:0;border-top:1px solid rgba(242,238,228,.22);display:block;margin:0;min-height:auto;padding:2rem 0}.pc-case-figure{align-items:baseline;display:flex;flex-wrap:wrap;font-size:clamp(3.2rem,14vw,4.7rem);gap:.05em .16em;margin-top:2.6rem;white-space:normal}.pc-case small{display:block;margin-top:3rem}.pc-podcast{padding:5rem 1.2rem}.pc-podcast-stats{grid-template-columns:1fr;margin:3rem 0 5rem}.pc-podcast-stats div{border-left:0;border-top:1px solid var(--pc-line);padding-left:0}.pc-episode{display:block;padding:2rem 1.4rem}.pc-episode-mark{height:5rem;margin-bottom:3rem;width:5rem}.pc-episode>a{display:inline-block;margin-top:2rem}.pc-source-note{align-items:start;flex-direction:column;gap:.8rem}.pc-about-quote{margin:3rem 0}.pc-final-cta{padding:7rem 1.2rem}.pc-final-cta h2{font-size:clamp(3.3rem,14vw,5.4rem)}.pc-site-footer{grid-template-columns:1fr;padding:3rem 1.2rem}}@media(max-width:380px){.pc-header-cta-label{display:none}.pc-header-cta{max-width:none}.pc-signature{font-size:1.22rem}.pc-hero-copy,.pc-manifesto,.pc-cases,.pc-podcast,.pc-about,.pc-final-cta{padding-left:1rem;padding-right:1rem}.pc-hero h1{font-size:clamp(2.9rem,13vw,3.4rem)}.pc-primary-button{gap:1rem;min-width:0;width:100%}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.pc-home *,.pc-home *:before,.pc-home *:after{scroll-behavior:auto!important;transition:none!important}}</style><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://pochocosta.com/#/schema/WebSite","url":"https://pochocosta.com/","name":"POCHO COSTA","description":"Ayudo a empresas a usar IA para conseguir más resultados con menos esfuerzo","inLanguage":"es","publisher":{"@id":"https://pochocosta.com/#/schema/Person"}},{"@type":"WebPage","@id":"https://pochocosta.com/","url":"https://pochocosta.com/","name":"Pocho Costa — Inteligencia artificial con criterio","description":"Ayudo a dueños de PyMEs y profesionales a aplicar inteligencia artificial con criterio a problemas reales. Podcast, casos y Pioneros IA.","inLanguage":"es","isPartOf":{"@id":"https://pochocosta.com/#/schema/WebSite"},"breadcrumb":{"@type":"BreadcrumbList","@id":"https://pochocosta.com/#/schema/BreadcrumbList","itemListElement":{"@type":"ListItem","position":1,"name":"POCHO COSTA"}},"potentialAction":{"@type":"ReadAction","target":"https://pochocosta.com/"},"about":{"@id":"https://pochocosta.com/#/schema/Person"}},{"@type":"Person","@id":"https://pochocosta.com/#/schema/Person","name":"POCHO COSTA","url":"https://pochocosta.com/","sameAs":["https://facebook.com/pochocostacom","https://twitter.com/pochocosta","https://www.linkedin.com/in/costapablo/"]}]}</script> <title>Pocho Costa — Inteligencia artificial con criterio</title><link rel='dns-prefetch' href='//www.googletagmanager.com' /><link rel='dns-prefetch' href='//use.fontawesome.com' /><link rel="alternate" type="application/rss+xml" title="POCHO COSTA &raquo; Feed" href="https://pochocosta.com/feed/" /><link rel="alternate"